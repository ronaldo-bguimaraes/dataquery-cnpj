# Usuário dos containers Airflow
AIRFLOW_UID=

# ============================================================================
# Armazenamento: RustFS (S3-compatível) iniciado pelo docker compose
# ============================================================================
# Raw e Bronze ficam no bucket criado por `rustfs-init`; não há mais volume
# local de dados. Use `filesystem` apenas para testes/CLI fora do Compose.
CNPJ_STORAGE_BACKEND=s3
CNPJ_S3_ENDPOINT=http://rustfs:9000
CNPJ_S3_BUCKET=cnpj-data
CNPJ_S3_ACCESS_KEY=rustfsadmin
CNPJ_S3_SECRET_KEY=rustfsadmin
CNPJ_S3_REGION=us-east-1

# Portal RustFS: http://localhost:9001 (API S3 em http://localhost:9000)
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# Troque as credenciais acima antes de expor o RustFS fora de localhost.
# Valores default são públicos e servem somente para desenvolvimento local.

# ============================================================================
# Filesystem opcional (somente fora do Compose / testes)
# ============================================================================
# CNPJ_STORAGE_BACKEND=filesystem
# CNPJ_DATA_ROOT=/data
# CNPJ_DATA_HOST_DIR=../data

# ============================================================================
# Portal de consulta (PostgreSQL + web + loader)
# ============================================================================
CNPJ_QUERY_COMPETENCIA=2026-10
CNPJ_QUERY_SOURCE=Receita Federal
CNPJ_QUERY_PAGE_SIZE=25
CNPJ_QUERY_PORT=8000
CNPJ_QUERY_DATABASE_URL=
CNPJ_QUERY_APP_PASSWORD=
CNPJ_QUERY_LOADER_PASSWORD=
POSTGRES_QUERY_PORT=55432
POSTGRES_QUERY_DB=cnpj_query
POSTGRES_QUERY_TEST_DB=cnpj_query_test
POSTGRES_QUERY_USER=cnpj_query_loader
POSTGRES_QUERY_PASSWORD=
