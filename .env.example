AIRFLOW_UID=

# Armazenamento local (default): filesystem em /data (host: ./data)
CNPJ_STORAGE_BACKEND=filesystem
CNPJ_DATA_ROOT=/data
# Opcional: diretório do host montado em /data (default: ../data)
# CNPJ_DATA_HOST_DIR=../data

# Backend de produção (R2/S3-compatível): preencha somente se CNPJ_STORAGE_BACKEND=s3
CNPJ_S3_ENDPOINT=
CNPJ_S3_BUCKET=
CNPJ_S3_ACCESS_KEY=
CNPJ_S3_SECRET_KEY=
CNPJ_S3_REGION=

# Portal de consulta (PostgreSQL + web)
CNPJ_QUERY_COMPETENCIA=2026-10
CNPJ_QUERY_SOURCE=Receita Federal
CNPJ_QUERY_PAGE_SIZE=25
CNPJ_QUERY_PORT=8000
CNPJ_QUERY_DATABASE_URL=
CNPJ_QUERY_APP_PASSWORD=
CNPJ_QUERY_LOADER_PASSWORD=
POSTGRES_QUERY_PORT=55432
POSTGRES_QUERY_DB=cnpj_query
POSTGRES_QUERY_TEST_DB=cnpj_query_test
POSTGRES_QUERY_USER=cnpj_query_loader
POSTGRES_QUERY_PASSWORD=
